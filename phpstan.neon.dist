includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 8
    phpVersion: 80100
    paths:
        - src
        - factory.php
        - tests
    # PHPDoc types are not enforced at runtime and the SDK keeps defensive checks
    # (e.g. instanceof in CachedOAuth), so they must not be reported as redundant.
    treatPhpDocTypesAsCertain: false
