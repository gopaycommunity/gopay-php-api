{
  "name": "gopay/payments-sdk-php",
  "description": "GoPay's PHP SDK for Payments REST API",
  "keywords": [
    "gopay",
    "payments",
    "sdk",
    "rest",
    "api"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "GoPay",
      "homepage": "https://github.com/gopaycommunity/gopay-php-api/contributors"
    }
  ],
  "config": {
    "bin-dir": "bin",
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": {
      "captainhook/hook-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "GoPay\\": "src/"
    },
    "files": [
      "factory.php"
    ],
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "files": [
      "vendor/hamcrest/hamcrest-php/hamcrest/Hamcrest.php"
    ]
  },
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.7.0",
    "symfony/deprecation-contracts": "^3.3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "9.6.33",
    "hamcrest/hamcrest-php": "*",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.95",
    "captainhook/hook-installer": "^1.0",
    "captainhook/captainhook": "^5.29"
  },
  "scripts": {
    "phpstan": "phpstan analyse --no-progress",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix"
  }
}
